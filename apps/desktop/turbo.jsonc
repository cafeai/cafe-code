{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "@cafeai/cafe-code#build"],
      "outputs": ["dist-electron/**"],
    },
    "dev": {
      "dependsOn": ["@cafeai/cafe-code#build"],
      "persistent": true,
    },
    "start": {
      "dependsOn": ["build", "@cafecode/web#build", "@cafeai/cafe-code#build"],
      "cache": false,
      "persistent": true,
    },
    "start:debug": {
      "dependsOn": ["build", "@cafecode/web#build", "@cafeai/cafe-code#build"],
      "cache": false,
      "persistent": true,
    },
    "smoke-test": {
      "dependsOn": ["build", "@cafecode/web#build", "@cafeai/cafe-code#build"],
      "cache": false,
      "outputs": [],
    },
  },
}
