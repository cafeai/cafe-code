+//! Metadata-only, private reverse channel to the owning Electron process.
+//! Capture fails closed when visible status cannot be acknowledged. No capture
+//! bytes, input values, clipboard or secrets are included in activity records.
+use serde_json::{json, Value};
+use std::io::{BufRead, BufReader, Read, Write};
+use std::os::unix::net::UnixStream;
+use std::time::Duration;
+
+pub fn required() -> bool {
+    std::env::var("CUA_DRIVER_CAFE_ACTIVITY_REQUIRED").as_deref() == Ok("1")
+}
+
+static INDICATOR_IDS: std::sync::Mutex<Vec<u32>> = std::sync::Mutex::new(Vec::new());
+pub fn is_indicator(pid: i32, title: &str, window_id: u32) -> bool {
+    std::env::var("CUA_DRIVER_EMBEDDED_HOST_PID")
+        .ok()
+        .and_then(|v| v.parse::<i32>().ok())
+        == Some(pid)
+        && (title == "Cafe computer-use indicator"
+            || INDICATOR_IDS
+                .lock()
+                .is_ok_and(|ids| ids.contains(&window_id)))
+}
+
+pub fn window_target(pid: i32, window_id: u32) -> anyhow::Result<Value> {
+    let inventory = crate::windows::visible_windows_for_indicator();
+    let on_screen = inventory.iter().any(|w| w.window_id == window_id);
+    let window = inventory
+        .iter()
+        .find(|w| w.window_id == window_id)
+        .cloned()
+        .or_else(|| crate::windows::window_info_by_id(window_id))
+        .ok_or_else(|| anyhow::anyhow!("activity target closed"))?;
+    anyhow::ensure!(
+        window.pid == pid && !is_indicator(pid, &window.title, window.window_id),
+        "activity target ownership changed"
+    );
+    let b = &window.bounds;
+    // Never paint an always-on-top outline through an overlapping foreground
+    // window. The menu item still identifies the controlled background target.
+    let mut ax_windows = std::collections::HashMap::new();
+    let occluded = on_screen
+        && inventory.iter().any(|w| {
+            w.window_id != window_id
+                && w.layer == 0
+                && !is_indicator(w.pid, &w.title, w.window_id)
+                && !crate::cursor::overlay::is_overlay_window(w.window_id)
+                && w.is_on_screen
+                && w.z_index > window.z_index
+                && w.bounds.x < b.x + b.width
+                && w.bounds.x + w.bounds.width > b.x
+                && w.bounds.y < b.y + b.height
+                && w.bounds.y + w.bounds.height > b.y
+                && {
+                    // A concurrent instance of this same reviewed executable
+                    // has its own transparent cursor surface. Recognize only
+                    // its untitled, exact main-display surface, without taking
+                    // control of that process or excluding ordinary windows.
+                    if is_peer_cursor_surface(w) {
+                        return false;
+                    }
+                    if !w.title.trim().is_empty() {
+                        return true;
+                    }
+                    // WindowServer lists untitled fullscreen titlebar helpers
+                    // at layer zero. A successful AXWindows read distinguishes
+                    // those from app windows.
+                    // Unknown/unresponsive apps remain potential occluders.
+                    // Bound the number of distinct AX reads per refresh.
+                    if !ax_windows.contains_key(&w.pid) && ax_windows.len() < 8 {
+                        ax_windows.insert(w.pid, crate::ax::bindings::ax_window_ids_of_pid(w.pid));
+                    }
+                    may_occlude(w.window_id, ax_windows.get(&w.pid).and_then(Option::as_ref))
+                }
+        });
+    Ok(
+        json!({ "scope":"window", "pid":pid, "windowId":window_id, "app":window.app_name.chars().take(160).collect::<String>(), "title":window.title.chars().take(160).collect::<String>(), "bounds":b, "visible":on_screen && !occluded, "visibilityReason":if !on_screen { "off-screen" } else if occluded { "occluded" } else { "visible" } }),
+    )
+}
+
+fn is_peer_cursor_surface(window: &crate::windows::WindowInfo) -> bool {
+    if !required() || !window.title.is_empty() {
+        return false;
+    }
+    let main = core_graphics::display::CGDisplay::main().bounds();
+    let b = &window.bounds;
+    if b.x != main.origin.x
+        || b.y != main.origin.y
+        || b.width != main.size.width
+        || b.height != main.size.height
+    {
+        return false;
+    }
+    let Some(path) = crate::apps::path_of_pid(window.pid) else {
+        return false;
+    };
+    std::env::current_exe()
+        .is_ok_and(|own| same_runtime_location(&own, std::path::Path::new(&path)))
+}
+
+fn same_runtime_location(own: &std::path::Path, peer: &std::path::Path) -> bool {
+    let runtime_name = |directory: &std::path::Path| -> Option<String> {
+        let name = directory.file_name()?.to_str()?;
+        // prepare-cua-driver atomically retires a runtime into this exact
+        // sibling namespace while its existing helper may still be alive.
+        let base = match name.split_once(".previous-") {
+            Some((base, stamp))
+                if !stamp.is_empty() && stamp.bytes().all(|b| b.is_ascii_digit()) =>
+            {
+                base
+            }
+            Some(_) => return None,
+            None => name,
+        };
+        Some(base.to_owned())
+    };
+    let (Some(a), Some(b)) = (own.parent(), peer.parent()) else {
+        return false;
+    };
+    own.file_name() == peer.file_name()
+        && a.parent().is_some()
+        && a.parent() == b.parent()
+        && runtime_name(a).is_some()
+        && runtime_name(a) == runtime_name(b)
+}
+
+fn may_occlude(window_id: u32, ax_ids: Option<&std::collections::HashSet<u32>>) -> bool {
+    ax_ids.is_none_or(|ids| ids.contains(&window_id))
+}
+
+pub fn capture_target(window_id: Option<u32>) -> anyhow::Result<Value> {
+    match window_id {
+        Some(id) => {
+            let w = crate::windows::window_info_by_id(id)
+                .ok_or_else(|| anyhow::anyhow!("capture target closed"))?;
+            window_target(w.pid, id)
+        }
+        None => {
+            let r = core_graphics::display::CGDisplay::main().bounds();
+            Ok(
+                json!({"scope":"display","app":"Main display","title":"Whole main display","visible":true,"bounds":{"x":r.origin.x,"y":r.origin.y,"width":r.size.width,"height":r.size.height}}),
+            )
+        }
+    }
+}
+
+pub fn notify(kind: &str, target: &Value) -> anyhow::Result<()> {
+    if !required() {
+        return Ok(());
+    }
+    let path = std::env::var("CUA_DRIVER_CAFE_ACTIVITY_SOCKET")?;
+    let token = std::env::var("CUA_DRIVER_CAFE_ACTIVITY_TOKEN")?;
+    let mut stream = UnixStream::connect(path)?;
+    stream.set_read_timeout(Some(Duration::from_millis(2000)))?;
+    stream.set_write_timeout(Some(Duration::from_millis(2000)))?;
+    let bytes = serde_json::to_vec(&json!({"token":token,"kind":kind,"target":target}))?;
+    anyhow::ensure!(bytes.len() < 4096, "activity metadata exceeded its bound");
+    stream.write_all(&bytes)?;
+    stream.write_all(b"\n")?;
+    let mut response = String::new();
+    BufReader::new(stream).take(256).read_line(&mut response)?;
+    let ids = acknowledged(&response)?;
+    let owner = std::env::var("CUA_DRIVER_EMBEDDED_HOST_PID")?.parse::<i32>()?;
+    let inventory = crate::windows::all_windows_for_indicator_exclusion();
+    anyhow::ensure!(
+        ids.iter().all(|id| inventory
+            .iter()
+            .find(|w| w.window_id == *id)
+            .is_none_or(|w| w.pid == owner)),
+        "indicator ownership changed"
+    );
+    *INDICATOR_IDS
+        .lock()
+        .map_err(|_| anyhow::anyhow!("indicator identities unavailable"))? = ids;
+    Ok(())
+}
+
+fn acknowledged(response: &str) -> anyhow::Result<Vec<u32>> {
+    anyhow::ensure!(
+        response.ends_with('\n') && response.len() <= 256,
+        "visible activity ACK missing"
+    );
+    let value: Value = serde_json::from_str(response)?;
+    anyhow::ensure!(
+        value.get("ok").and_then(Value::as_bool) == Some(true),
+        "visible activity refused"
+    );
+    let ids = value
+        .get("exclude_windows")
+        .and_then(Value::as_array)
+        .ok_or_else(|| anyhow::anyhow!("indicator identities missing"))?;
+    anyhow::ensure!(ids.len() <= 8, "too many indicator identities");
+    ids.iter()
+        .map(|v| {
+            v.as_u64()
+                .filter(|id| *id > 0 && *id <= u32::MAX as u64)
+                .map(|id| id as u32)
+                .ok_or_else(|| anyhow::anyhow!("invalid indicator identity"))
+        })
+        .collect()
+}
+#[cfg(test)]
+mod tests {
+    #[test]
+    fn cursor_peers_require_the_exact_current_or_atomically_retired_runtime_namespace() {
+        use std::path::Path;
+        let own = Path::new("/runtime/darwin-arm64/cua-driver");
+        for peer in [
+            "/runtime/darwin-arm64/cua-driver",
+            "/runtime/darwin-arm64.previous-123/cua-driver",
+        ] {
+            assert!(super::same_runtime_location(own, Path::new(peer)));
+        }
+        for peer in [
+            "/other/darwin-arm64/cua-driver",
+            "/runtime/darwin-x64/cua-driver",
+            "/runtime/darwin-arm64.previous-/cua-driver",
+            "/runtime/darwin-arm64.previous-abc/cua-driver",
+            "/runtime/darwin-arm64/other",
+        ] {
+            assert!(!super::same_runtime_location(own, Path::new(peer)));
+        }
+    }
+    #[test]
+    fn known_accessory_surfaces_do_not_occlude_but_unknown_apps_do() {
+        let ids = std::collections::HashSet::from([42]);
+        assert!(super::may_occlude(42, Some(&ids)));
+        assert!(!super::may_occlude(43, Some(&ids)));
+        assert!(super::may_occlude(43, None));
+    }
+    #[test]
+    fn capture_requires_exact_visible_status_and_bounded_native_identities() {
+        assert_eq!(
+            super::acknowledged("{\"ok\":true,\"exclude_windows\":[42]}\n").unwrap(),
+            vec![42]
+        );
+        for response in [
+            "",
+            "ok\n",
+            "refused\n",
+            "{\"ok\":true}",
+            "{\"ok\":true,\"exclude_windows\":[0]}\n",
+            "{\"ok\":false,\"exclude_windows\":[]}\n",
+        ] {
+            assert!(super::acknowledged(response).is_err());
+        }
+    }
+}
