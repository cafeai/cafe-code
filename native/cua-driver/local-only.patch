diff --git a/libs/cua-driver/rust/crates/platform-macos/src/input/ownership.rs b/libs/cua-driver/rust/crates/platform-macos/src/input/ownership.rs
new file mode 100644
index 0000000..dd13395
--- /dev/null
+++ b/libs/cua-driver/rust/crates/platform-macos/src/input/ownership.rs
@@ -0,0 +1,256 @@
+//! Human input supersedes an automation lease. A passive HID tap observes only
+//! event provenance and increments a counter; no key, position, or text is kept.
+//! If the tap cannot be installed or is disabled, foreground input fails closed.
+use std::ffi::c_void;
+use std::sync::{
+    atomic::{AtomicBool, AtomicU64, Ordering},
+    OnceLock,
+};
+
+static EPOCH: AtomicU64 = AtomicU64::new(1);
+static AVAILABLE: AtomicBool = AtomicBool::new(false);
+static STARTED: OnceLock<bool> = OnceLock::new();
+fn event_marker() -> i64 {
+    static MARKER: OnceLock<i64> = OnceLock::new();
+    *MARKER.get_or_init(|| {
+        let bytes = uuid::Uuid::new_v4().into_bytes();
+        (i64::from_ne_bytes(bytes[..8].try_into().unwrap()) & i64::MAX).max(1)
+    })
+}
+
+#[derive(Clone, Copy, Debug)]
+pub struct Lease(u64);
+impl Lease {
+    pub fn current(self) -> bool {
+        owns(
+            cfg!(test) || AVAILABLE.load(Ordering::Acquire),
+            self.0,
+            EPOCH.load(Ordering::Acquire),
+        )
+    }
+}
+
+pub fn mark(event: &core_graphics::event::CGEvent) {
+    event.set_integer_value_field(
+        core_graphics::event::EventField::EVENT_SOURCE_USER_DATA,
+        event_marker(),
+    );
+}
+
+fn is_external(pid: i64, marker: i64, own_pid: i64, own_marker: i64) -> bool {
+    pid != own_pid && marker != own_marker
+}
+
+unsafe extern "C" fn observe(
+    _: *mut c_void,
+    kind: u32,
+    event: *mut c_void,
+    _: *mut c_void,
+) -> *mut c_void {
+    if kind >= 0xffff_fffe {
+        AVAILABLE.store(false, Ordering::Release);
+    } else if !event.is_null()
+        && is_external(
+            CGEventGetIntegerValueField(event, 41),
+            CGEventGetIntegerValueField(event, 42),
+            std::process::id() as i64,
+            event_marker(),
+        )
+    {
+        EPOCH.fetch_add(1, Ordering::AcqRel);
+    }
+    event
+}
+
+fn owns(available: bool, saved: u64, current: u64) -> bool {
+    available && saved == current
+}
+
+pub fn lease() -> anyhow::Result<Lease> {
+    // Unit fixtures qualify the clock logic without installing an OS input tap.
+    #[cfg(test)]
+    {
+        return Ok(Lease(EPOCH.load(Ordering::Acquire)));
+    }
+    let started = *STARTED.get_or_init(|| {
+        let (tx, rx) = std::sync::mpsc::sync_channel(1);
+        let spawned = std::thread::Builder::new()
+            .name("cafe-human-input".into())
+            .spawn(move || unsafe {
+                // Down/up, keyboard, modifiers, pointer movement/drag, and wheel.
+                // Listen-only: the callback never modifies or suppresses an event.
+                let mask = [1u32, 2, 3, 4, 5, 6, 7, 10, 11, 12, 22, 25, 26, 27]
+                    .iter()
+                    .fold(0u64, |m, k| m | (1 << k));
+                let tap = CGEventTapCreate(0, 0, 1, mask, observe, std::ptr::null_mut());
+                if tap.is_null() {
+                    let _ = tx.send(false);
+                    return;
+                }
+                let source = CFMachPortCreateRunLoopSource(std::ptr::null(), tap, 0);
+                if source.is_null() {
+                    CFRelease(tap);
+                    let _ = tx.send(false);
+                    return;
+                }
+                CFRunLoopAddSource(CFRunLoopGetCurrent(), source, kCFRunLoopCommonModes);
+                AVAILABLE.store(true, Ordering::Release);
+                let _ = tx.send(true);
+                CFRunLoopRun();
+                AVAILABLE.store(false, Ordering::Release);
+                CFRelease(source);
+                CFRelease(tap);
+            });
+        spawned.is_ok()
+            && rx
+                .recv_timeout(std::time::Duration::from_secs(1))
+                .unwrap_or(false)
+    });
+    anyhow::ensure!(
+        started && AVAILABLE.load(Ordering::Acquire),
+        "human input monitoring is unavailable; foreground input refused"
+    );
+    Ok(Lease(EPOCH.load(Ordering::Acquire)))
+}
+
+extern "C" {
+    fn CGEventTapCreate(
+        location: u32,
+        placement: u32,
+        options: u32,
+        mask: u64,
+        callback: unsafe extern "C" fn(*mut c_void, u32, *mut c_void, *mut c_void) -> *mut c_void,
+        data: *mut c_void,
+    ) -> *mut c_void;
+    fn CGEventGetIntegerValueField(event: *mut c_void, field: u32) -> i64;
+    fn CFMachPortCreateRunLoopSource(
+        allocator: *const c_void,
+        port: *mut c_void,
+        order: isize,
+    ) -> *mut c_void;
+    fn CFRunLoopGetCurrent() -> *mut c_void;
+    fn CFRunLoopAddSource(run_loop: *mut c_void, source: *mut c_void, mode: *const c_void);
+    fn CFRunLoopRun();
+    fn CFRelease(value: *mut c_void);
+    static kCFRunLoopCommonModes: *const c_void;
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn external_input_has_priority() {
+        assert!(owns(true, 1, 1));
+        assert!(!owns(true, 1, 2));
+        assert!(!owns(false, 1, 1));
+        assert!(is_external(0, 0, 123, 55));
+        assert!(is_external(456, 0, 123, 55));
+        assert!(!is_external(123, 0, 123, 55));
+        assert!(!is_external(0, 55, 123, 55));
+        // Another helper's tagged event supersedes this helper's lease too.
+        assert!(is_external(456, 56, 123, 55));
+    }
+
+    #[test]
+    fn foreground_identity_cannot_follow_a_new_focus_target() {
+        assert!(owns_foreground(
+            true,
+            (Some(10), Some(20)),
+            (Some(10), Some(20))
+        ));
+        assert!(!owns_foreground(
+            false,
+            (Some(10), Some(20)),
+            (Some(10), Some(20))
+        ));
+        assert!(!owns_foreground(
+            true,
+            (Some(10), Some(20)),
+            (Some(11), Some(21))
+        ));
+        assert!(!owns_foreground(
+            true,
+            (Some(10), Some(20)),
+            (Some(10), Some(21))
+        ));
+        assert!(!owns_foreground(true, (None, None), (None, None)));
+    }
+}
+
+/// Check before starting each character/gesture. Finish a dispatched down/up
+/// pair to avoid stuck input, then refuse all remaining input on lost ownership.
+pub struct ForegroundGuard {
+    lease: Lease,
+    pid: Option<i32>,
+    window: Option<u32>,
+}
+pub fn foreground_guard() -> anyhow::Result<ForegroundGuard> {
+    let lease = lease()?;
+    let (pid, window) = match EXPECTED_WINDOW.with(|v| v.get()) {
+        Some((pid, window)) => (Some(pid), Some(window)),
+        None => {
+            let pid = crate::apps::frontmost_pid();
+            (
+                pid,
+                pid.and_then(crate::ax::bindings::focused_window_id_of_pid),
+            )
+        }
+    };
+    Ok(ForegroundGuard { lease, pid, window })
+}
+impl ForegroundGuard {
+    pub fn announce_pointer(&self) -> anyhow::Result<()> {
+        self.check()?;
+        announce_pointer()?;
+        self.check()
+    }
+
+    pub fn check(&self) -> anyhow::Result<()> {
+        let pid = crate::apps::frontmost_pid();
+        let window = pid.and_then(crate::ax::bindings::focused_window_id_of_pid);
+        anyhow::ensure!(
+            owns_foreground(self.lease.current(), (self.pid, self.window), (pid, window)),
+            "foreground input ownership changed; remaining input refused without replay"
+        );
+        Ok(())
+    }
+}
+
+/// Announce only at the real-pointer dispatch boundary, including an AX
+/// action that selected a pixel fallback. A window overlay move never calls it.
+pub fn announce_pointer() -> anyhow::Result<()> {
+    if !crate::cafe_activity::required() {
+        return Ok(());
+    }
+    let target = match EXPECTED_WINDOW.with(|v| v.get()) {
+        Some((pid, window)) => crate::cafe_activity::window_target(pid, window)?,
+        None => crate::cafe_activity::capture_target(None)?,
+    };
+    crate::cafe_activity::notify("using-pointer", &target)
+}
+
+fn owns_foreground(
+    owned: bool,
+    expected: (Option<i32>, Option<u32>),
+    actual: (Option<i32>, Option<u32>),
+) -> bool {
+    owned && expected.0.is_some() && expected.1.is_some() && expected == actual
+}
+
+thread_local! { static EXPECTED_WINDOW: std::cell::Cell<Option<(i32,u32)>> = const { std::cell::Cell::new(None) }; }
+pub fn with_target<T>(
+    pid: i32,
+    window: u32,
+    action: impl FnOnce() -> anyhow::Result<T>,
+) -> anyhow::Result<T> {
+    struct Restore(Option<(i32, u32)>);
+    impl Drop for Restore {
+        fn drop(&mut self) {
+            EXPECTED_WINDOW.with(|v| v.set(self.0));
+        }
+    }
+    let prior = EXPECTED_WINDOW.with(|v| v.replace(Some((pid, window))));
+    let _restore = Restore(prior);
+    foreground_guard()?.check()?;
+    action()
+}
