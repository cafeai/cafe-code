{
  "sourceCommit": "b0968e1b12834e485dda68789541a3cc57664a9f",
  "contractVersion": "0.8.0",
  "tools": [
    {
      "name": "click",
      "description": "Click coordinates or a snapshot-bound element with an explicit target and delivery mode.",
      "inputSchema": {
        "additionalProperties": false,
        "oneOf": [
          {
            "not": {
              "required": ["element_token"]
            },
            "required": ["x", "y"]
          },
          {
            "not": {
              "anyOf": [
                {
                  "required": ["x"]
                },
                {
                  "required": ["y"]
                },
                {
                  "required": ["capture_id"]
                }
              ]
            },
            "required": ["element_token"]
          }
        ],
        "properties": {
          "button": {
            "default": null,
            "enum": ["left", "right", "middle"],
            "type": "string"
          },
          "capture_id": {
            "default": null,
            "minLength": 1,
            "type": "string"
          },
          "count": {
            "default": null,
            "maximum": 3,
            "minimum": 1,
            "type": "integer"
          },
          "delivery_mode": {
            "enum": ["background", "foreground"],
            "type": "string"
          },
          "element_token": {
            "default": null,
            "pattern": "^s[0-9a-f]{8}:[0-9]+$",
            "type": "string"
          },
          "target": {
            "description": "Exact capture/input target selected independently for each action.\n\n`display_id=\"primary\"` is the portable desktop target in this release.\nPlatforms that cannot address another display reject it explicitly rather\nthan silently changing coordinate spaces.",
            "oneOf": [
              {
                "additionalProperties": true,
                "properties": {
                  "kind": {
                    "const": "window",
                    "type": "string"
                  },
                  "pid": {
                    "minimum": 0,
                    "type": "integer"
                  },
                  "window_id": {
                    "minimum": 0,
                    "type": "integer"
                  }
                },
                "required": ["kind", "pid", "window_id"],
                "type": "object"
              },
              {
                "additionalProperties": true,
                "properties": {
                  "display_id": {
                    "type": "string"
                  },
                  "kind": {
                    "const": "desktop",
                    "type": "string"
                  }
                },
                "required": ["kind", "display_id"],
                "type": "object"
              }
            ]
          },
          "x": {
            "default": null,
            "type": "number"
          },
          "y": {
            "default": null,
            "type": "number"
          }
        },
        "required": ["target", "delivery_mode"],
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": true
      }
    },
    {
      "name": "drag",
      "description": "Drag between two absolute points in get_desktop_state coordinates.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "button": {
            "enum": ["left", "right", "middle"],
            "type": "string"
          },
          "duration_ms": {
            "maximum": 10000,
            "minimum": 0,
            "type": "integer"
          },
          "from_x": {
            "type": "number"
          },
          "from_y": {
            "type": "number"
          },
          "modifier": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "scope": {
            "const": "desktop",
            "description": "Deprecated flat desktop target retained for wire compatibility."
          },
          "steps": {
            "maximum": 200,
            "minimum": 1,
            "type": "integer"
          },
          "target": {
            "anyOf": [
              {
                "description": "Exact capture/input target selected independently for each action.\n\n`display_id=\"primary\"` is the portable desktop target in this release.\nPlatforms that cannot address another display reject it explicitly rather\nthan silently changing coordinate spaces.",
                "oneOf": [
                  {
                    "additionalProperties": true,
                    "properties": {
                      "kind": {
                        "const": "window",
                        "type": "string"
                      },
                      "pid": {
                        "minimum": 0,
                        "type": "integer"
                      },
                      "window_id": {
                        "minimum": 0,
                        "type": "integer"
                      }
                    },
                    "required": ["kind", "pid", "window_id"],
                    "type": "object"
                  },
                  {
                    "additionalProperties": true,
                    "properties": {
                      "display_id": {
                        "type": "string"
                      },
                      "kind": {
                        "const": "desktop",
                        "type": "string"
                      }
                    },
                    "required": ["kind", "display_id"],
                    "type": "object"
                  }
                ]
              },
              {
                "type": "null"
              }
            ],
            "description": "Preferred per-call target: an exact window (`kind=\"window\"`, `pid`, `window_id`) or the\nprimary desktop (`kind=\"desktop\"`, `display_id=\"primary\"`)."
          },
          "to_x": {
            "type": "number"
          },
          "to_y": {
            "type": "number"
          }
        },
        "required": ["from_x", "from_y", "to_x", "to_y"],
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": true
      }
    },
    {
      "name": "get_desktop_state",
      "description": "Capture the complete primary display at native resolution for a desktop-scope GUI loop.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "max_image_dimension": {
            "description": "Optional long-edge cap for the returned PNG, in pixels. Omitted or 0\nreturns the full-size capture. When the cap downsizes the image,\ndesktop-scope x/y taken from it are mapped back automatically.",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [],
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "get_screen_size",
