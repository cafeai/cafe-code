    {
      "name": "get_window_state",
      "description": "Observe an exact native window with snapshot-bound elements and optional screenshots.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "include_accessibility_tree": {
            "type": "boolean"
          },
          "include_screenshot": {
            "type": "boolean"
          },
          "max_depth": {
            "minimum": 1,
            "type": "integer"
          },
          "max_dimension": {
            "minimum": 1,
            "type": "integer"
          },
          "max_elements": {
            "minimum": 1,
            "type": "integer"
          },
          "max_image_dimension": {
            "description": "Optional per-call long-edge ceiling. Zero requests native resolution;\nomit it to preserve the configured session or global behavior.",
            "minimum": 0,
            "type": "integer"
          },
          "pid": {
            "maximum": 4294967295,
            "minimum": 1,
            "type": "integer"
          },
          "query": {
            "type": "string"
          },
          "timeout_ms": {
            "description": "Wall-clock budget for the accessibility walk in milliseconds\n(default 1000 on every platform). A walk that runs out returns a\npartial tree flagged `truncated` rather than failing.",
            "maximum": 120000,
            "minimum": 100,
            "type": "integer"
          },
          "window_id": {
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": ["pid", "window_id"],
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      }
    },
